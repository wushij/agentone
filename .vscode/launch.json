{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "后端 dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "uvicorn main:app --reload --host 0.0.0.0 --port 8000",
      "cwd": "${workspaceFolder}/backend"
    },
    {
      "name": "前端 dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    {
      "name": "全栈 dev",
      "configurations": [
        "后端 dev",
        "前端 dev"
      ]
    }
  ]
}
