# 关系型数据库 (根据使用的数据库解合/选择对应连接串)
# 选项 A: MySQL
DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/agentone?charset=utf8mb4
# 选项 B: PostgreSQL
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@127.0.0.1:5432/agentone

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# JWT
SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM：mock 无需 Key；deepseek 需填写 API Key
LLM_PROVIDER=mock
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 向量库：空=使用普通 JSON 存储；./qdrant_db=开启本地嵌入式 Qdrant 高性能向量库
QDRANT_URL=./qdrant_db
